{
  "name": "docx-translate-pipeline",
  "version": "2.0.0",
  "description": "OtterTranslator: allowlisted DOCX translation with a browser UI, persistent quotas and safe formatting fallback",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "docx-translate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "node --test --import tsx test/**/*.test.ts",
    "prepublishOnly": "npm run build",
    "server": "node --env-file-if-exists=.env dist/server/index.js",
    "server:dev": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "test:browser": "playwright test",
    "check:tools": "tsc -p tsconfig.tools.json",
    "mailbox": "node --import tsx scripts/dev-mailbox.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.7",
    "@xmldom/xmldom": "^0.9.12",
    "adm-zip": "^0.6.1",
    "fastify": "^5.12.8",
    "nodemailer": "^10.3.1",
    "ollama": "^0.5.9",
    "sqlite3": "^6.0.1",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "docx",
    "translation",
    "formatting-preservation",
    "self-hosted"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  }
}

# Node 22.12+; npm run build && npm run server
PORT=3000
ORIGIN=http://localhost:3000
DB_PATH=./data/app.db
OUTPUT_DIR=./data/outputs
EMAIL_ALLOWLIST=you@example.com
# SMTP submission; use existing mail service credentials (no new paid service needed).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OtterTranslator <you@example.com>
# Use an Azure Translator F0 resource, dedicated to this app.
MS_TRANSLATOR_KEY=
MS_TRANSLATOR_REGION=westeurope
# Optional: leave empty until billing controls / shared credit are verified.
GOOGLE_CLOUD_API_KEY=
TRANSLATION_BACKEND=composite
# Off by default. Keys alone do not enable review on the server.
ENABLE_LLM_REVIEW=false
CEREBRAS_API_KEY=
GROQ_API_KEY=
CEREBRAS_VERIFY_MODEL=gpt-oss-120b
GROQ_VERIFY_MODEL=openai/gpt-oss-120b
